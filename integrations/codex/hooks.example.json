{
  "description": "Inject bounded Othie context at the start of Codex turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/absolute/path/to/node \"$(git rev-parse --show-toplevel)/integrations/codex/dist/src/user-prompt-submit.js\" --cli \"$(git rev-parse --show-toplevel)/packages/engine/dist/src/cli.js\" --config \"$(git rev-parse --show-toplevel)/config.json\" --bridge codex --credential-file \"$(git rev-parse --show-toplevel)/.othie/bridge-codex.credential\" --max-tokens 500 --deadline-ms 2000",
            "timeout": 3,
            "statusMessage": "Loading Othie context",
            "additionalContextLimit": 600
          }
        ]
      }
    ]
  }
}
