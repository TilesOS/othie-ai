    "documents": [
      {
        "name": "archive-badges.md",
        "text": "Archive badges must be deactivated at expiration. A conservator may extend a badge for one day if an inventory review is still in progress."
      },
      {
        "name": "visitor-badges.md",
        "text": "Visitor badges must be deactivated at expiration. Security may reactivate a visitor badge only after a new identity check."
      },
      {
        "name": "specimen-labels.md",
        "text": "Specimen labels require a barcode before shipment. During an outage, a handwritten specimen label may be used if the manifest has a barcode."
      },
      {
        "name": "parcel-labels.md",
        "text": "Parcel labels require a barcode before shipment. Unreadable labels must be replaced before the parcel leaves the dock."
      },
      {
        "name": "current-rinse.md",
        "text": "The current standard requires staff to rinse sample trays before inspection. Staff must discard each damaged tray."
      },
      {
        "name": "legacy-rinse.md",
        "text": "The legacy standard prohibits rinsing sample trays before inspection. Staff must set aside each damaged tray for review."
      },
      {
        "name": "outage-log.md",
        "text": "The duty officer must log every outage before notifying the dock. This guide does not set specimen labeling or badge expiration requirements."
      },
      {
        "name": "report-layout.md",
        "text": "The weekly report lists archive badges, visitor badges, specimen labels, parcel labels and sample trays in separate columns."
      }
    ],
