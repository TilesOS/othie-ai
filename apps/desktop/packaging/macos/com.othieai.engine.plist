<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.othieai.engine</string>
  <key>ProgramArguments</key>
  <array>
    <string>__ABSOLUTE_NODE_PATH__</string>
    <string>__ABSOLUTE_OTHIE_CLI_PATH__</string>
    <string>engine</string><string>foreground</string>
    <string>--config</string><string>__ABSOLUTE_CONFIG_PATH__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__ABSOLUTE_LOG_DIRECTORY__/engine.stdout.log</string>
  <key>StandardErrorPath</key><string>__ABSOLUTE_LOG_DIRECTORY__/engine.stderr.log</string>
</dict>
</plist>
